{
  "name": "threads-analytics",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma migrate deploy && next build",
    "start": "prisma migrate deploy && next start",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "typecheck": "tsc --noEmit",
    "desktop:prisma:generate": "prisma generate --schema desktop/runtime/prisma/schema.prisma",
    "desktop:prisma:validate": "prisma validate --config desktop/prisma.config.ts",
    "desktop:typecheck": "tsc --project tsconfig.desktop.json --noEmit",
    "desktop:dev:web": "node desktop/scripts/dev-web.mjs",
    "desktop:build:web": "node desktop/scripts/build-next.mjs",
    "desktop:package:check": "node desktop/scripts/package-macos.mjs --check",
    "desktop:package:macos": "node desktop/scripts/package-macos.mjs",
    "desktop:smoke:macos": "node desktop/scripts/smoke-test-app.mjs",
    "desktop:open:macos": "open 'desktop/zig-out/package/Threads Analytics.app'",
    "desktop:start:web": "node desktop/runtime/start-server.mjs",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "desktop:test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test desktop/tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/client-runtime-utils": "^7.10.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.49.0",
    "mcp-handler": "^2.2.0",
    "next": "16.3.7",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@native-sdk/cli": "0.10.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "better-sqlite3": "^13.0.3"
    }
  }
}
